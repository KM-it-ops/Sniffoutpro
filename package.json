{
  "name": "sniffoutpro",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "local": "node scripts/ensure-local-postgres.mjs && pnpm --filter @sniffoutpro/web dev",
    "package:desktop": "pnpm --filter @sniffoutpro/desktop package",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "prod:bootstrap": "powershell -ExecutionPolicy Bypass -File scripts/prod-bootstrap.ps1",
    "prod:verify": "node scripts/verify-production.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@sniffoutpro/config": "workspace:*",
    "eslint": "^9.24.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "next": "^15.5.27",
    "prettier": "^3.5.3",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "handlebars@<4.7.10": "4.7.10",
      "esbuild@<0.25.0": ">=0.25.0",
      "postcss@<8.5.23": "^8.5.23",
      "@grpc/grpc-js@<1.14.5": "^1.14.5",
      "@opentelemetry/propagator-jaeger@<2.9.0": "^2.9.0",
      "brace-expansion@^1": "^1.1.21",
      "brace-expansion@^2": "^2.1.7",
      "brace-expansion@^5": "^5.0.12",
      "browserslist@<4.28.7": "^4.28.7",
      "fast-uri@<3.1.8": "^3.1.8",
      "js-yaml@^4": "^4.3.2",
      "nanoid@<3.3.18": "^3.3.18",
      "source-map-js@<1.2.2": "^1.2.2",
      "tinypool@<2.1.2": "^2.1.2"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19",
        "react-dom": "19"
      },
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
