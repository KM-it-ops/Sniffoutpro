# Desktop agent (Vite) — baked in at build time. Use Doppler or CI secrets.

# Production web dashboard URL (no trailing slash)
VITE_WEB_URL=https://your-app.vercel.app

# Same Supabase project as the website. The desktop sends this user's session, not a shared secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
