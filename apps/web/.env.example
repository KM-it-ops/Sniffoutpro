# Web control plane (Next.js) — copy to Doppler or Vercel env. Never commit real values.

# PostgreSQL (Supabase pooler or direct connection string)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Optional: most database connections each server instance may open at once (default 10).
# DATABASE_POOL_MAX=10

# Unused by the API. A signed-in user's tier is the users.tier column.
# Someone with no user row is personal, not workstation.

# Required in production — desktop agent must send matching Bearer token
SNIFFOUT_SYNC_TOKEN=

# Optional — enables Supabase JWT auth on sync routes
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Public copies of the same Supabase project, for the website sign-in pages.
# Leave blank until that project's auth is turned on. Do not put the service role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — Inngest background jobs (CVE sync cron)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
