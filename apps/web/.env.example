# Web control plane (Next.js) — copy to Doppler or Vercel env. Never commit real values.

# PostgreSQL (Supabase pooler or direct connection string)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Tier flag: PERSONAL | WORKSTATION | CONSULTANT | ADMIN
SNIFFOUT_TIER=WORKSTATION

# Required in production — desktop agent must send matching Bearer token
SNIFFOUT_SYNC_TOKEN=

# Optional — enables Supabase JWT auth on sync routes
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional — Inngest background jobs (CVE sync cron)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
