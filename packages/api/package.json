{
  "name": "@sniffoutpro/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "default": "./dist/router.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sniffoutpro/db": "workspace:*",
    "@sniffoutpro/scan-engine": "workspace:*",
    "@sniffoutpro/types": "workspace:*",
    "@trpc/server": "^11.1.0",
    "drizzle-orm": "^0.45.2",
    "neverthrow": "^8.2.0",
    "pino": "^9.6.0",
    "superjson": "^2.2.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@sniffoutpro/config": "workspace:*",
    "@types/node": "^22.14.1",
    "eslint": "^9.24.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
