{
  "name": "@sniffoutpro/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "default": "./dist/zod.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@sniffoutpro/types": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.7.1",
    "postgres": "^3.4.5",
    "@libsql/client": "^0.14.0",
    "sql.js": "^1.13.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@sniffoutpro/config": "workspace:*",
    "@types/sql.js": "^1.4.9",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.24.0",
    "typescript": "^5.8.3",
    "vitest": "^5.0.3"
  }
}
